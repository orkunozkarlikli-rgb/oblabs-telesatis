{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-oblabs",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./portal",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "oblabs_leads_db",
      "database_name": "oblabs-leads-db",
      "database_id": "d69f7339-57b7-4806-9e33-b8dc5967661e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS_KV",
      "id": "cbbc83841fb74273b9ea003cb5c4c0c2"
    }
  ],
  "routes": [
    {
      "pattern": "data.oblabs.com.tr",
      "custom_domain": true
    }
  ]
}
